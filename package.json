{
  "name": "paddlepal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PaddlePal (拍档) - Table Tennis Tournament Management System",
  "engines": {
    "node": ">=24.18.1",
    "pnpm": ">=11.19.0"
  },
  "overrides": {
    "picomatch": ">=4.0.4",
    "brace-expansion": ">=5.0.5",
    "yaml": ">=2.8.3"
  },
  "onlyBuiltDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ],
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "vitest related --run"
    ]
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute paddlepal-db --file=sql/schema.sql",
    "db:init:local": "wrangler d1 execute paddlepal-db --local --file=sql/schema.sql",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^10.0.1",
    "@types/papaparse": "^5.5.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  },
  "dependencies": {
    "hono": "^4.12.32",
    "papaparse": "^5.5.4"
  },
  "packageManager": "pnpm@11.19.0"
}
